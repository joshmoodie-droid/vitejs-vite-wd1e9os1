# Copy to .env for local dev. Set the same keys in Vercel for production.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Optional — error monitoring. Leave blank to disable (local dev / CI).
# In Vercel, set it to the DSN from your Sentry project.
VITE_SENTRY_DSN=
