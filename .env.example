# Copy to .env for local dev. Set the same keys in Vercel for production.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Optional — error monitoring. Leave blank to disable (local dev / CI).
# In Vercel, set it to the DSN from your Sentry project.
VITE_SENTRY_DSN=

# Optional — source-map upload (readable stack traces + releases in Sentry).
# BUILD-time only, not shipped to the browser. Set these three in Vercel on the
# Production environment; leave unset everywhere else and the build skips upload.
#   SENTRY_AUTH_TOKEN  — Sentry → Settings → Auth Tokens, scope `project:releases`
#   SENTRY_ORG         — your Sentry org slug
#   SENTRY_PROJECT     — the frontend project slug (javascript-react)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
